{% extends 'layout_app.html.twig' %}

{% block app_title %}Dashboard - TravelParadise{% endblock %} {# Définit le titre de l'application dans la balise <title> #}
{% block page_title %}Dashboard Overview{% endblock %} {# Définit le titre affiché dans le header #}

{% block content %}
    {# Ici, tu mets le contenu spécifique de la page du tableau de bord #}

    <h2 class="text-2xl font-bold text-gray-800 mb-6">Dashboard Overview</h2>

    {# Exemple de cartes d'information #}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {# Carte 1 #}
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-lg font-semibold text-gray-700 mb-2">Total Users</h3>
            <p class="text-3xl font-bold text-teal-600">1,234</p> {# Remplace par des données dynamiques #}
        </div>
        {# Carte 2 #}
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-lg font-semibold text-gray-700 mb-2">New Bookings</h3>
            <p class="text-3xl font-bold text-blue-600">56</p> {# Remplace par des données dynamiques #}
        </div>
        {# Carte 3 #}
        <div class="bg-white p-6 rounded-lg shadow-md">
            <h3 class="text-lg font-semibold text-gray-700 mb-2">Revenue</h3>
            <p class="text-3xl font-bold text-green-600">$12,345</p> {# Remplace par des données dynamiques #}
        </div>
    </div>

    {# ... autres sections du tableau de bord (graphiques, listes récentes, etc.) ... #}

{% endblock %}
