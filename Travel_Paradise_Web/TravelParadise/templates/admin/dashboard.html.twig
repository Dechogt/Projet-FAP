                            {# CORRECTION ICI #}
                            <div class="text-2xl font-semibold text-gray-900">{{ stats.totalVisiteurs }}</div>
                        </dd>
                    </div>
                </div>
            </div>
             <div class="bg-gray-50 px-5 py-3">
                <div class="text-sm">
                    {# Si tu as une page pour lister les visiteurs, adapte la route #}
