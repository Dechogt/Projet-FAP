    {# Section pour les listes de visites (si tu veux les afficher) #}
    {% if visitesAujourdhuiList is not empty %}
        <div class="mt-8">
            <h3 class="text-lg font-medium leading-6 text-gray-900">Visites prévues aujourd'hui</h3>
            {# Affiche la liste des visites d'aujourd'hui ici #}
            {# Exemple : une simple liste #}
            <ul class="mt-4 border-t border-gray-200 divide-y divide-gray-200">
                {% for visite in visitesAujourdhuiList %}
                    <li class="py-4 flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="ml-3">
                                <p class="text-sm font-medium text-gray-900">{{ visite.nom }}</p> {# Adapte si le nom de la visite est différent #}
                                <p class="text-sm text-gray-500">{{ visite.date|date('H:i') }} avec {{ visite.guide.nom }}</p> {# Adapte si les propriétés sont différentes #}
                            </div>
                        </div>
                        {# Ajoute un lien vers la page de détail de la visite si elle existe #}
                        {# <a href="{{ path('app_visite_show', {'id': visite.id}) }}" class="ml-6 whitespace-nowrap text-sm font-medium text-blue-600 hover:text-blue-800">Voir</a> #}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

     {% if visitesProchainementList is not empty %}
        <div class="mt-8">
            <h3 class="text-lg font-medium leading-6 text-gray-900">Visites prochaines</h3>
             {# Affiche la liste des visites prochaines ici #}
             <ul class="mt-4 border-t border-gray-200 divide-y divide-gray-200">
                {% for visite in visitesProchainementList %}
                    <li class="py-4 flex items-center justify-between">
                        <div class="flex items-center">
                            <div class="ml-3">
                                <p class="text-sm font-medium text-gray-900">{{ visite.nom }}</p> {# Adapte si le nom de la visite est différent #}
                                <p class="text-sm text-gray-500">{{ visite.date|date('Y-m-d H:i') }} avec {{ visite.guide.nom }}</p> {# Adapte si les propriétés sont différentes #}
                            </div>
                        </div>
                        {# Ajoute un lien vers la page de détail de la visite si elle existe #}
                        {# <a href="{{ path('app_visite_show', {'id': visite.id}) }}" class="ml-6 whitespace-nowrap text-sm font-medium text-blue-600 hover:text-blue-800">Voir</a> #}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

     {% if showWelcomeModal %}
        {# La balise 'include' insère le contenu de l'autre fichier ici. #}
        {# 'with {'userName': userName}' passe la variable 'userName' au template inclus. #}
        {% include 'components/welcome_modal.html.twig' with {'userName': userName} %}
    {% endif %}

    {% block javascripts %}
        {{ parent() }} {# Très important : inclut les scripts du layout parent #}

        {# Ajouter le script pour gérer l'affichage et la disparition de la modale #}
        {% if showWelcomeModal %} {# On inclut le script seulement si la modale doit être affichée #}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // On récupère la modale et le bouton OK par leurs IDs
                const modal = document.getElementById('welcome-modal');
                const okButton = document.getElementById('welcome-modal-ok-button');

                // Afficher la modale en retirant la classe 'hidden'
                modal.classList.remove('hidden');

                // Ajouter un écouteur d'événement sur le clic du bouton OK
                okButton.addEventListener('click', function() {
                    // Cacher la modale en ajoutant la classe 'hidden'
                    modal.classList.add('hidden');
                });

                // Optionnel : Cacher la modale si l'utilisateur clique sur l'overlay gris
                const overlay = modal.querySelector('.fixed.inset-0.transition-opacity');
                overlay.addEventListener('click', function() {
                    modal.classList.add('hidden');
                });
            });
        </script>
        {% endif %}
    {% endblock %}

{% endblock %}
