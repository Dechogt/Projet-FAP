{# templates/guide_touristique/edit.html.twig #}
{% extends 'layout_app.html.twig' %}

{% block app_title %}Modifier Guide - TravelParadise{% endblock %}
{% block page_title %}Modifier Guide Touristique{% endblock %}

{% block content %}

    <div class="max-w-2xl mx-auto p-6 bg-white rounded-lg shadow-md">

        <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center">Modifier Guide Touristique</h2>

        {# Inclusion du formulaire #}
        {# On passe l'entité guide_touristique au formulaire pour afficher l'image existante #}
        {% include 'guide_touristique/_form.html.twig' with {'form': form, 'guide_touristique': guide_touristique} %}

        {# Bouton de suppression (optionnel, souvent sur la page show ou index) #}
        {% include 'guide_touristique/_delete_form.html.twig' %}

    </div>

{% endblock %}
