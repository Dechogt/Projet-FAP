{% extends 'base.html.twig' %}

{% block title %}GuideTouristique index{% endblock %}

{% block body %}
    <h1>GuideTouristique index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Prenom</th>
                <th>Photo</th>
                <th>Statut</th>
                <th>PaysAffectation</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for guide_touristique in guide_touristiques %}
            <tr>
                <td>{{ guide_touristique.id }}</td>
                <td>{{ guide_touristique.nom }}</td>
                <td>{{ guide_touristique.prenom }}</td>
                <td>{{ guide_touristique.photo }}</td>
                <td>{{ guide_touristique.statut ? 'Yes' : 'No' }}</td>
                <td>{{ guide_touristique.paysAffectation }}</td>
                <td>
                    <a href="{{ path('app_guide_touristique_show', {'id': guide_touristique.id}) }}">show</a>
                    <a href="{{ path('app_guide_touristique_edit', {'id': guide_touristique.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_guide_touristique_new') }}">Create new</a>
{% endblock %}
