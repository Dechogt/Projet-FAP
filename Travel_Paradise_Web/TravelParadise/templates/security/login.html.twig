{% extends 'base.html.twig' %}

{% block title %}Connexion - TravelParadise{% endblock %}

{% block body %}
<div class="max-w-md mx-auto">
    <div class="card">
        <!-- Logo et titre -->
        <div class="text-center mb-8">
            <div class="text-6xl mb-4">🏝️</div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">TravelParadise</h1>
            <p class="text-gray-600">Administration</p>
        </div>

        <!-- Erreurs de connexion -->
        {% if error %}
            <div class="alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <!-- Formulaire de connexion -->
        <form method="post" class="space-y-6">
            <div class="form-group">
                <label for="inputEmail" class="form-label">
                    📧 Adresse e-mail
                </label>
                <input type="email" 
                       value="{{ last_username }}" 
                       name="email" 
                       id="inputEmail" 
                       class="form-input" 
                       autocomplete="email" 
                       required 
                       autofocus
                       placeholder="votre.email@travelparadise.com">
            </div>

            <div class="form-group">
                <label for="inputPassword" class="form-label">
                    🔒 Mot de passe
                </label>
                <input type="password" 
                       name="password" 
                       id="inputPassword" 
                       class="form-input" 
                       autocomplete="current-password" 
                       required
                       placeholder="••••••••">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="flex items-center justify-between">
                <div class="flex items-center">
                    <input id="remember_me" 
                           name="_remember_me" 
                           type="checkbox" 
                           class="h-4 w-4 text-primary-600 focus:ring-primary-500 border-gray-300 rounded">
                    <label for="remember_me" class="ml-2 block text-sm text-gray-700">
                        Se souvenir de moi
                    </label>
                </div>
                <!-- Futur lien "Mot de passe oublié" -->
            </div>

            <button type="submit" class="w-full btn-primary">
                🚀 Se connecter
            </button>
        </form>

        <!-- Informations de test (à supprimer en prod) -->
        <div class="mt-8 p-4 bg-blue-50 border border-blue-200 rounded-lg">
            <h3 class="text-sm font-medium text-blue-800 mb-2">🧪 Comptes de test :</h3>
            <div class="text-xs text-blue-700 space-y-1">
                <div><strong>Admin :</strong> admin@travelparadise.com</div>
                <div><strong>Staff :</strong> staff@travelparadise.com</div>
                <div><em>Mot de passe : password123</em></div>
            </div>
        </div>
    </div>
</div>
{% endblock %}